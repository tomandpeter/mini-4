# Public network configuration. NEXT_PUBLIC_* values are visible in the browser.
# Do not use a private RPC URL containing a secret token.
NEXT_PUBLIC_MINI4_CHAIN_ID=
NEXT_PUBLIC_MINI4_RPC_URL=
NEXT_PUBLIC_MINI4_EXPLORER_URL=

# Circuit #1: NAND
NEXT_PUBLIC_MINI4_NAND_ADDRESS=
NEXT_PUBLIC_MINI4_NAND_SIGNATURE=nand(bool,bool)

# Circuit #2: NOT
NEXT_PUBLIC_MINI4_NOT_ADDRESS=
NEXT_PUBLIC_MINI4_NOT_SIGNATURE=not(bool)

# Circuit #3: AND
NEXT_PUBLIC_MINI4_AND_ADDRESS=
NEXT_PUBLIC_MINI4_AND_SIGNATURE=and(bool,bool)

# Circuit #4: XOR
NEXT_PUBLIC_MINI4_XOR_ADDRESS=
NEXT_PUBLIC_MINI4_XOR_SIGNATURE=xor(bool,bool)

# Circuit #5: 1-bit half adder
NEXT_PUBLIC_MINI4_HALF_ADDER_ADDRESS=
NEXT_PUBLIC_MINI4_HALF_ADDER_SIGNATURE=halfAdder(bool,bool)

# Never add private keys, seed phrases, or signing credentials here.
